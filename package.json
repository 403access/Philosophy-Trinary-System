{
  "name": "mathematische-philosophie-trinaeritaet",
  "version": "0.1.0",
  "private": true,
  "description": "Forschungsprogramm zur Trinärität — Docusaurus-Site, Dokumentation und Paper-Export.",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
